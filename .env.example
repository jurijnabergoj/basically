# Google Gemini API key (free tier) — get one at https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your key below.
GEMINI_API_KEY=your-key-here

# Supabase — for the "Challenge a friend" multiplayer mode (optional; solo works without it).
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key   # browser realtime only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key   # server only — NEVER expose to client
